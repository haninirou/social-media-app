# EXAMPLE - environment variable configuration
# COPY this file to .env and change the values

# Database configuration - Docker
MYSQL_ROOT_PASSWORD=your_mysql_password
MYSQL_DATABASE=question
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# Database configuration - Spring Boot local
DB_NAME=question
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT configuration
QUESTION_APP_SECRET=your_very_long_and_secure_jwt_key
JWT_SECRET=your_very_long_and_secure_jwt_key
QUESTION_EXPIRES_IN=350000
JWT_EXPIRES_IN=350000
REFRESH_TOKEN_EXPIRES_IN=700000